# GoHighLevel — Inbound Webhook URL of the workflow
# "AMBASSADEUR PRO METCARE® — INSCRIPTION". Server-side only.
# Without it the form works in development (payload is logged) and answers
# "registrations are not open yet" in production.
GHL_AMBASSADOR_WEBHOOK_URL=

# Meta Pixel + Conversions API. Leave empty to turn tracking off.
# Pixel / dataset id, read in the browser (inlined at build time).
NEXT_PUBLIC_META_PIXEL_ID=
# Dataset id for the server-side CAPI call; falls back to NEXT_PUBLIC_META_PIXEL_ID.
META_PIXEL_ID=
# Conversions API access token. Server-side only.
META_CAPI_ACCESS_TOKEN=
# Optional: send events to Events Manager › Test events.
META_TEST_EVENT_CODE=

# Google Analytics 4 (optional override; defaults to G-RJ16CFPCHR)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
